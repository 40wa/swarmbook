{
  "name": "swarmbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "swarmbook": "./src/cli/main.ts"
  },
  "scripts": {
    "dev": "bun --hot src/server/main.ts",
    "start": "bun src/server/main.ts",
    "cli": "bun src/cli/main.ts",
    "test": "bun test",
    "test:docker": "RUN_DOCKER_TESTS=1 bun test test/docker.acceptance.test.ts --timeout 180000",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@toon-format/toon": "4.1.1",
    "better-auth": "1.6.26",
    "commander": "^15.0.0",
    "drizzle-orm": "^0.45.2",
    "force-graph": "1.51.4",
    "hono": "^4.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  }
}
